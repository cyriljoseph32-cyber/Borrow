# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mettre "true" seulement si le compte Stripe est ouvert en Thailande
STRIPE_ENABLE_PROMPTPAY=false

# --- Cron ---
CRON_SECRET=

# --- SMS OTP (Twilio Verify) --- optionnel : sans ces clés, le téléphone
# est enregistré sans vérification (comportement de secours pour le dev local)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- E-mails transactionnels (Resend) --- optionnel : sans clé, les emails
# sont simplement sautés (no-op), rien ne casse
RESEND_API_KEY=
RESEND_FROM="Borrow <onboarding@resend.dev>"
